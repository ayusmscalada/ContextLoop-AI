{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "sample-data/corpus/**" }
  }
}
