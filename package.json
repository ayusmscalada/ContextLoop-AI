{
  "name": "contextloop-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ContextLoop AI - self-improving organizational intelligence & shared AI memory",
  "bin": {
    "ctxloop": "server/bin/ctxloop.mjs"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm --prefix web run dev\"",
    "server": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "seed": "tsx server/src/seed.ts",
    "mcp": "tsx server/src/mcp.ts",
    "cli": "tsx server/src/cli.ts",
    "typecheck": "tsc -p server --noEmit",
    "setup": "npm install && npm --prefix web install && npm run seed",
    "mcp:smoke": "tsx server/src/scripts/mcp-smoke.ts",
    "gen:samples": "tsx server/src/scripts/gen-sample-data.ts",
    "eval:report": "tsx server/src/scripts/eval-report.ts",
    "build": "npm --prefix web run build",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.21",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2"
  }
}
